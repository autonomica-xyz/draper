# Draper Marketing Pipeline Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Data directory
# =============================================================================

# Shared data root for dashboard, worker, MCP, and CLI.
# When unset, defaults to <repo>/data.
# DRAPER_DATA_DIR=/var/lib/draper/data

# =============================================================================
# Dashboard / MCP Security
# =============================================================================

# Required for dashboard production use. Generate with: openssl rand -hex 32
DRAPER_DASHBOARD_TOKEN=

# Development-only escape hatch for loopback access without auth.
# Never enable this in production or behind a reverse proxy.
# DRAPER_ALLOW_UNAUTHENTICATED_LOCAL=1

# Optional project-scoped MCP stdio/HTTP exposure.
# DRAPER_MCP_PROJECT_ID=your-project-id
# DRAPER_MCP_TOKEN=
# DRAPER_MCP_ROLE=editor

# =============================================================================
# LLM Provider (at least one required)
# =============================================================================

# Anthropic (Claude) - recommended
ANTHROPIC_API_KEY=

# OpenAI (GPT-4) - alternative
# OPENAI_API_KEY=

# Custom API endpoint (optional - for proxies)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model selection (optional)
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_FALLBACKS=claude-3-5-sonnet-20241022,gpt-4o

# =============================================================================
# Typefully (required for scheduling)
# =============================================================================

# Get your API key at: https://typefully.com/settings/api
TYPEFULLY_API_KEY=

# Per-project social set IDs are configured via:
#   draper project config --set twitter_social_set_id=YOUR_ID
#   draper project config --set linkedin_social_set_id=YOUR_ID
#
# Find IDs: Enable Development mode in Typefully (Settings -> API)

# =============================================================================
# Gamma.app (for carousel and presentation generation)
# =============================================================================

# Get your API key at: https://developers.gamma.app
# Docs: https://developers.gamma.app/reference/generate-a-gamma
GAMMA_APP_API_KEY=

# =============================================================================
# Optional Integrations
# =============================================================================

# ZAI (for text generation via GLM-4.7 and image generation via GLM-Image)
# Used by: generator/zai_content_generator.py, integrations/zai_image.py
# Image generation cost: $0.015/image
# ZAI_API_KEY=...

# Late API (for multi-platform social scheduling)
# Get your API key at: https://trylate.com/settings
# LATE_API_KEY=...

# DynaPictures (for template-based image generation)
# DYNAPICTURES_API_KEY=...

# Nostr (for decentralized publishing)
# NOSTR_PRIVATE_KEY=nsec...

# Nostr relays for publishing + analytics (comma-separated; wss:// assumed)
# Used by: nostr/relay_client.py, nostr/nostr_publisher.py
# NOSTR_RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol

# Optional: pin which extension identity (npub or hex) may sign Nostr events.
# When set, signatures from any other key are rejected server-side.
# Leave unset to accept any NIP-07 signer.
# NOSTR_PUBKEY=npub1...
