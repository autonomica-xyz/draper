[Unit]
Description=Draper Marketing Pipeline Dashboard
After=network.target

[Service]
Type=simple
User=draper
Group=draper
WorkingDirectory=/opt/draper
Environment=PATH=/opt/draper/.venv/bin:/usr/bin:/bin
Environment=DRAPER_REQUIRE_AUTH=1
Environment=DASHBOARD_SECURE_COOKIE=1
EnvironmentFile=/etc/draper.env
ExecStart=/opt/draper/.venv/bin/python -m dashboard.unified_dashboard --run-server --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/draper/data

[Install]
WantedBy=multi-user.target
