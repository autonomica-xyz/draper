[Unit]
Description=Draper Idea Lab mining tick (enqueue mine_ideas)
After=network.target draper-worker.service

[Service]
Type=oneshot
User=draper
Group=draper
WorkingDirectory=/opt/draper
Environment=PATH=/opt/draper/.venv/bin:/usr/bin:/bin
Environment=DRAPER_DATA_DIR=/opt/draper/data
EnvironmentFile=-/etc/draper.env
ExecStart=/opt/draper/.venv/bin/python -m cli idea-mining tick
Nice=10

[Install]
WantedBy=multi-user.target
